{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "kill-old-qemu",
            "type": "shell",
            "command": "pkill -9 qemu-system-riscv64 || true",
            "problemMatcher": []
        },
        {
            "label": "start-qemu",
            "type": "shell",
            "command": "qemu-system-riscv64",
            "args": [
                "-machine", "virt",
                "-nographic",
                "-bios", "none",
                "-kernel", "${workspaceFolder}/target/riscv64gc-unknown-none-elf/debug/os",
                "-s",
                "-S"
            ],
            "isBackground": true,
            "dependsOn": ["kill-old-qemu"],
            "problemMatcher": {
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern":  "."
                }
            }
        }
    ]
}